{
  "$id": "https://omnidesk.local/schemas/appsettings.schema.json",
  "title": "OmniDesk appsettings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ConnectionStrings": {
      "type": "object",
      "properties": {
        "DefaultConnection": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "Jwt": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string"
        },
        "Issuer": {
          "type": "string"
        },
        "Audience": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Logging": {
      "type": "object",
      "properties": {
        "LogLevel": {
          "type": "object",
          "properties": {
            "Default": {
              "type": "string"
            },
            "Microsoft.AspNetCore": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "AllowedHosts": {
      "type": "string"
    }
  },
  "additionalProperties": true
